# Firecrawl — powers "pull a real post from LinkedIn" in the Workspace.
#
# Deliberately NOT prefixed with VITE_. A VITE_ variable is inlined into the
# client bundle and would be readable by anyone who opens the deployed site;
# this key is only ever read server-side, by the Vite dev middleware locally
# and by the Cloudflare Pages Function in production.
#
# Local:      copy this file to .env (already gitignored) and fill it in.
# Production: set the same name in the Cloudflare Pages project settings
#             (Settings → Environment variables), not in this file.
FIRECRAWL_API_KEY=fc-your-key-here
