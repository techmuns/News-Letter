# Copy this file to `.env` for local `vite dev`, or set it in your host's
# build environment. These are client-side (Vite `import.meta.env`) values —
# never put secrets here, they end up in the shipped bundle.

# --- Munshot host embedding (JWT session handshake) ---
# Comma-separated exact scheme+host origins allowed to postMessage a session
# into this app via the Munshot Dashboard SDK. This is the entire trust
# boundary for accepting a host-provided JWT — no wildcards, no subdomain
# matching, scheme and port both count.
# Leave unset to use the hardcoded default (https://chat.muns.io) in
# src/lib/sdk.ts — an empty/missing value here does NOT disable the check.
VITE_MUNSHOT_ALLOWED_ORIGINS=https://chat.muns.io
