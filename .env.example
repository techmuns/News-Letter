# LLM transport configuration (Node scripts only — never bundled into the app).
# Copy to .env.local and fill in. .env* is already gitignored.

# --- Provider selection ------------------------------------------------------
# Unset (default): use Bedrock if BEDROCK_API_KEY is present, else OpenAI.
# Set to "openai" to flip back to OpenAI as primary.
# LLM_PROVIDER=openai

# --- Claude on Amazon Bedrock (primary) --------------------------------------
# Bedrock bearer token. Sent as the x-api-key header — no SigV4, no AWS SDK.
# NOTE: Bedrock bearer tokens are short-lived (12 hours max). For anything
# long-running, mint a fresh token or move to a Bedrock service role.
BEDROCK_API_KEY=

# Endpoint is https://bedrock-mantle.{BEDROCK_REGION}.api.aws/anthropic
BEDROCK_REGION=us-east-1

# Fallback chain, tried in order. A 403/404 means this account has no access to
# that model, so the next one is tried. Opus 5 access is granted per-account on
# Bedrock, so a 403 on the first entry is expected and handled.
# BEDROCK_MODELS=anthropic.claude-opus-5,anthropic.claude-opus-4-8,anthropic.claude-sonnet-5

# Structured-output mode. Leave unset to probe once and pin the winner.
# json_schema = output_config.format; tool = forced single-tool use.
# BEDROCK_STRUCTURED_MODE=tool

# --- OpenAI (automatic fallback) ---------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Shared ------------------------------------------------------------------
# LLM_MAX_TOKENS=8192
# Set to 1 to strip JSON Schema keywords Anthropic rejects (minimum, maxLength,
# ...) instead of erroring. Off by default so no schema changes silently.
# LLM_SCHEMA_STRIP=1

# --- Offline testing only ----------------------------------------------------
# Point the transport at a local stub instead of AWS / OpenAI.
# BEDROCK_BASE_URL=http://127.0.0.1:3000/anthropic
# OPENAI_BASE_URL=http://127.0.0.1:3000/v1
