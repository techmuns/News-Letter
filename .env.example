# Firecrawl — powers the auto-generator's signal feed.
# Get a key at https://firecrawl.dev, then copy this file to `.env`.
#
# Deliberately NOT prefixed with VITE_: unprefixed vars are never inlined into
# the client bundle. The key is read only by the /api routes (Vite dev
# middleware locally, Cloudflare Pages Functions in production).
FIRECRAWL_API_KEY=fc-your-key-here

# Optional — point at a self-hosted Firecrawl instead of the cloud API.
# FIRECRAWL_API_URL=https://firecrawl.example.com/v2
