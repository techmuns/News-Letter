{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-letter",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  // The @cloudflare/vite-plugin auto-populates assets.directory with the client
  // build output. Non-/api routes fall through to the worker, which serves the
  // SPA via env.ASSETS (single-page-application handling returns index.html).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
