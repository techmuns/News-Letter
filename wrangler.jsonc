{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-letter",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "build": { "command": "npm run build" },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  }

  // ── Auto-image hosting (optional) ────────────────────────────────────────
  // The branded PNG is stored in Workers KV and served at /img/<id>, then that
  // public URL is handed to Buffer. To turn this on (one time, free):
  //   1. Run:  npx wrangler kv namespace create STORE
  //   2. Copy the printed id into the block below and UN-comment it (drop the
  //      leading "// ," so it becomes a real sibling of "assets").
  //   3. Commit + push (or redeploy) — /api/health then shows "images": true.
  // Until then the app runs fine; Studio just posts text-only (or you can paste
  // a Custom image URL manually). Do NOT commit a fake id — deploy will fail.
  //
  // ,"kv_namespaces": [{ "binding": "STORE", "id": "PASTE_YOUR_KV_NAMESPACE_ID_HERE" }]

  // ── Buffer OAuth ("Connect Buffer" — optional) ───────────────────────────
  // Per-user Buffer OAuth connections/PKCE state live in a D1 database. To
  // turn this on:
  //   1. Run:  npx wrangler d1 create news-letter-db
  //   2. Copy the printed database_id into the block below and UN-comment it.
  //   3. Run:  npx wrangler d1 migrations apply news-letter-db --remote
  //      (drop --remote for local dev against .wrangler's local D1)
  //   4. Set BUFFER_CLIENT_ID / BUFFER_CLIENT_SECRET / BUFFER_REDIRECT_URI /
  //      TOKEN_ENCRYPTION_KEY (see .dev.vars.example + SETUP.md).
  // Until then the app runs fine; the static BUFFER_ACCESS_TOKEN path keeps
  // working as-is. Do NOT commit a fake database_id — deploy will fail.
  //
  // ,"d1_databases": [{ "binding": "DB", "database_name": "news-letter-db", "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE" }]
}
