# Copy this file to `.dev.vars` for local `wrangler pages dev`.
# In production, set these in the Cloudflare dashboard instead
# (Workers & Pages -> your project -> Settings -> Variables and Secrets).
# See SETUP.md for where each value comes from. Never commit real secrets.

# --- Daily Pulse (content source) — no key needed ---
# Reads the public Daily Market Pulse feed (techmuns/DailyMarketPulse -> public/data/live.json).
# Optional: override the feed URL (e.g. the deployed dashboard's /data/live.json, or a pinned branch).
# DAILY_PULSE_URL=

# --- AI generation (AWS Bedrock — preferred) ---
# Bedrock API key, sent as `Authorization: Bearer …`. When set, generation goes
# to Bedrock's native runtime invoke endpoint:
#   POST https://bedrock-runtime.<region>.amazonaws.com/model/<model-id>/invoke
BEDROCK_API_KEY=
# The Bedrock model id / inference-profile id to invoke. Must be enabled in your
# account/region. In us-east-1, most current models need the cross-region
# inference-profile form (the `us.` prefix), e.g.:
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional region for the runtime host (defaults to us-east-1)
# BEDROCK_REGION=us-east-1

# --- AI generation (Anthropic Claude, direct) — fallback when no BEDROCK_API_KEY ---
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (Anthropic direct default claude-opus-5)
# GEN_MODEL=claude-sonnet-5

# --- Topic mode (recent-news lookup for the Daily Pulse composer) ---
# NewsAPI.org key. The composer's "Topic" tab queries the /v2/everything endpoint
# for recent news on a keyword, then grounds the post ONLY in the real articles
# it returns (title / description / url / source / publishedAt). Get a key at
# https://newsapi.org/register — sent server-side as the `X-Api-Key` header.
NEWSAPI_KEY=

# --- LinkedIn publishing (via Buffer) ---
# Token from https://publish.buffer.com/settings/api
BUFFER_ACCESS_TOKEN=
# The Buffer channel id for the Munshot LinkedIn page (see SETUP.md)
BUFFER_LINKEDIN_CHANNEL_ID=
# Optional: enables the /api/buffer-channels helper to list your channels
# BUFFER_ORG_ID=

# --- Buffer OAuth ("Connect Buffer" — per-user LinkedIn publishing) ---
# Requires a D1 database bound as `DB` (see wrangler.jsonc + SETUP.md — D1
# can't be configured via .dev.vars; it's a real binding).
# Register an app at publish.buffer.com/settings/api -> App Clients tab.
BUFFER_CLIENT_ID=
# Optional — Buffer's current "App Clients" UI only issues a client_id (a
# public PKCE client, no secret). Leave this unset; only fill it in if a
# future Buffer app type actually gives you one.
# BUFFER_CLIENT_SECRET=
# Must exactly match the redirect URI registered with the Buffer app, e.g.
# http://localhost:5173/api/auth/buffer/callback for local dev.
BUFFER_REDIRECT_URI=
# Base64-encoded 32-byte AES-256-GCM key for encrypting stored Buffer OAuth
# tokens at rest. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Munshot session verification (per-client isolation) ---
# The email claim in a Munshot JWT keys every per-user Buffer connection.
# WITHOUT one of these set, that claim is trusted WITHOUT checking the
# signature — meaning clients are NOT isolated from each other. Set exactly
# ONE, whichever Munshot's auth team provides. See SETUP.md §3b.
# MUNSHOT_JWKS_URL=https://.../.well-known/jwks.json
# MUNSHOT_JWT_PUBLIC_KEY={"kty":"RSA","n":"...","e":"AQAB","alg":"RS256"}
# MUNSHOT_JWT_HMAC_SECRET=
# No-key alternative: verify by calling a Munshot endpoint with the caller's
# own token. A token Munshot accepts must be Munshot-signed, so its claims are
# authentic. Any bearer-protected endpoint that 401s on a bad token works.
# MUNSHOT_VERIFY_URL=https://devde.muns.io/stock/search
# MUNSHOT_VERIFY_BODY={"query":"AAPL","user_index":124}
# MUNSHOT_VERIFY_METHOD=POST
# Optional — each checked only when set:
# MUNSHOT_JWT_ISSUER=
# MUNSHOT_JWT_AUDIENCE=
# Set to 'true' ONLY once a key above is configured and tested: rejects any
# request without a verified Munshot session (no shared-guest fallback).
# MUNSHOT_REQUIRE_VERIFIED_SESSION=true

# --- Email newsletter ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# SENDGRID_API_KEY=            # only if EMAIL_PROVIDER=sendgrid
EMAIL_FROM=Munshot Intelligence <news@yourdomain.com>
# Optional default recipient list (comma / newline separated)
EMAIL_RECIPIENTS=

# --- Security (recommended in production) ---
# If set, the UI must send this in the "App secret" field to publish/send.
APP_SECRET=
